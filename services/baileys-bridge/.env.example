# Example environment variables for Baileys Bridge
PORT=8080
LOG_LEVEL=info

# Supabase Credentials (Required)
# Uses new secret key (sb_secret_...) or legacy service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (legacy fallback)

# Shared Secret for Vercel <-> Render API calls (Required)
INTERNAL_SERVICE_KEY=devunomieta-secret-baileys-key-change-me

# Vercel CRM Webhook (Required for incoming chats and receipts)
CRM_WEBHOOK_URL=https://www.devunomieta.xyz/api/crm/webhooks/whatsapp
CRM_WEBHOOK_SECRET=crm-webhook-secret-change-me
